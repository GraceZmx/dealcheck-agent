# 大模型服务商：决定由哪家模型来驱动 Agent（可选值：deepseek，以后可扩展 claude 等）
LLM_PROVIDER=deepseek

# 模型名（可选）：不填时使用 backend/config/agent.yaml 里的默认值 deepseek-flash；正式评测可改为 deepseek-v4-pro
# LLM_MODEL=deepseek-flash

# 搜索服务商：决定 Agent 用谁的网页搜索 / 网页读取接口（可选值：deepseek）
SEARCH_PROVIDER=deepseek

# Agent 总开关：设为 false 时全站只用规则引擎，不调用 DeepSeek（线上出问题时可一键关闭）
AGENT_ENABLED=true

# 网页评估运行记录（只在本机排查问题时打开）：设为 true 时，网页上的每次评估也会存进 traces/，文件名带 web；线上 Render 不要设置
# SAVE_WEB_TRACES=true

# DeepSeek API 密钥：模型和搜索共用同一个 Key，在 DeepSeek 开放平台获取；真实 Key 只填在 .env 里，绝不能提交到 GitHub
DEEPSEEK_API_KEY=your-key-here
